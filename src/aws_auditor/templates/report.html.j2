<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AWS Compliance Report · {{ r.account_id }}</title>
<style>
  :root {
    --bg: #f7f8fa; --card: #fff; --text: #1d2330; --muted: #5f6b7a; --border: #e2e6ec;
    --critical: #c62828; --high: #e65100; --medium: #b58900; --low: #1565c0; --pass: #2e7d32;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #11151c; --card: #1a2029; --text: #e6e9ee; --muted: #9aa5b4; --border: #2a323e;
      --critical: #ef5350; --high: #ff8a50; --medium: #e0b84a; --low: #64a8f0; --pass: #66bb6a; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); }
  main { max-width: 1100px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { margin: 0 0 4px; font-size: 26px; }
  h2 { margin: 36px 0 12px; font-size: 19px; }
  .meta { color: var(--muted); font-size: 14px; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-top: 24px; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; }
  .card .value { font-size: 28px; font-weight: 700; margin-top: 4px; }
  .grade-A, .grade-B { color: var(--pass); } .grade-C { color: var(--medium); } .grade-D, .grade-F { color: var(--critical); }
  .bar { display: flex; height: 10px; border-radius: 5px; overflow: hidden; background: var(--border); margin-top: 10px; }
  .bar span { display: block; }
  table { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  tr:last-child td { border-bottom: 0; }
  .table-wrap { overflow-x: auto; }
  .nowrap { white-space: nowrap; }
  .sev { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; color: #fff; }
  .sev-CRITICAL { background: var(--critical); } .sev-HIGH { background: var(--high); }
  .sev-MEDIUM { background: var(--medium); } .sev-LOW { background: var(--low); } .sev-INFO { background: var(--muted); }
  .st-PASS { color: var(--pass); font-weight: 600; } .st-FAIL { color: var(--critical); font-weight: 600; }
  .st-ERROR { color: var(--medium); font-weight: 600; } .st-N\/A { color: var(--muted); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .filters label { background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px; cursor: pointer; font-size: 13px; }
  details { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; margin-bottom: 8px; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: 8px 0 0; font-family: ui-monospace, Menlo, monospace; font-size: 13px; white-space: pre-wrap; word-break: break-word; }
</style>
</head>
<body>
<main>
  <h1>AWS Compliance Audit Report</h1>
  <div class="meta">
    Account <code>{{ r.account_id }}</code> · {{ r.regions | length }} region(s) ·
    generated {{ r.finished_at.strftime("%Y-%m-%d %H:%M UTC") }} in {{ "%.1f" | format(duration) }}s
  </div>

  <section class="cards">
    <div class="card"><div class="label">Grade</div><div class="value grade-{{ s.grade }}">{{ s.grade }}</div></div>
    <div class="card"><div class="label">Compliance</div><div class="value">{{ s.compliance }}%</div>
      <div class="bar"><span style="width: {{ s.compliance }}%; background: var(--pass)"></span></div></div>
    <div class="card"><div class="label">Risk score</div><div class="value">{{ s.risk }}</div></div>
    <div class="card"><div class="label">Failed</div><div class="value">{{ s.failed }}</div></div>
    <div class="card"><div class="label">Passed</div><div class="value">{{ s.passed }}</div></div>
    <div class="card"><div class="label">Not evaluated</div><div class="value">{{ s.errors }}</div></div>
  </section>

  <section class="cards">
    {% for sev in severities %}
    <div class="card"><div class="label"><span class="sev sev-{{ sev }}">{{ sev }}</span></div>
      <div class="value">{{ s.failures_by_severity[sev] }}</div></div>
    {% endfor %}
  </section>

  <h2>Failed findings</h2>
  {% if r.failures %}
  <div class="filters" id="filters">
    {% for sev in severities %}<label><input type="checkbox" value="{{ sev }}" checked> {{ sev }}</label>{% endfor %}
  </div>
  <div class="table-wrap">
  <table id="findings">
    <thead><tr><th>Severity</th><th>Check</th><th>Region</th><th>Resource</th><th>Issue</th></tr></thead>
    <tbody>
    {% for f in r.failures %}
      <tr data-sev="{{ f.severity.value }}">
        <td><span class="sev sev-{{ f.severity.value }}">{{ f.severity.value }}</span></td>
        <td><strong>{{ f.check_id }}</strong><br><span class="meta">{{ f.title }}</span></td>
        <td class="nowrap">{{ f.region }}</td>
        <td><code>{{ f.resource_id }}</code></td>
        <td>{{ f.message }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p>No failed findings. 🎉</p>
  {% endif %}

  {% if remediations %}
  <h2>Remediation</h2>
  {% for cid, (title, fix) in remediations.items() %}
  <details><summary>{{ cid }} · {{ title }}</summary><p>{{ fix }}</p></details>
  {% endfor %}
  {% endif %}

  <h2>All checks</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>Check</th><th>Severity</th><th>Result</th><th>Pass</th><th>Fail</th></tr></thead>
    <tbody>
    {% for c in checks %}
      <tr>
        <td><strong>{{ c.id }}</strong></td>
        <td>{{ c.meta.title }}{% if c.meta.references %}<br><span class="meta">{{ c.meta.references | join(", ") }}</span>{% endif %}</td>
        <td><span class="sev sev-{{ c.meta.severity.value }}">{{ c.meta.severity.value }}</span></td>
        <td class="st-{{ c.status }}">{{ c.status }}</td>
        <td>{{ c.PASS }}</td>
        <td>{{ c.FAIL }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  {% if r.errors %}
  <h2>Checks that could not be evaluated</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Check</th><th>Region</th><th>Reason</th></tr></thead>
    <tbody>
    {% for f in r.errors %}<tr><td>{{ f.check_id }}</td><td>{{ f.region }}</td><td>{{ f.message }}</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
</main>
<script>
  document.querySelectorAll('#filters input').forEach(function (box) {
    box.addEventListener('change', function () {
      var on = Array.from(document.querySelectorAll('#filters input:checked')).map(function (b) { return b.value; });
      document.querySelectorAll('#findings tbody tr').forEach(function (row) {
        row.style.display = on.indexOf(row.dataset.sev) >= 0 ? '' : 'none';
      });
    });
  });
</script>
</body>
</html>
